{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-project-spotify-dev"
		},
		"AzureDataLakeStorageLinkedService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageprojectspotifydev.dfs.core.windows.net/"
		},
		"AzureSqlDatabaseLinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserver-project-spotify-dev.database.windows.net"
		},
		"AzureSqlDatabaseLinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-project-spotify-dev"
		},
		"Tumbling Window Trigger for Backfilling_properties_pipeline_parameters_start_date": {
			"type": "string",
			"defaultValue": "@{trigger().startTime}"
		},
		"Tumbling Window Trigger for Backfilling_properties_pipeline_parameters_end_date": {
			"type": "string",
			"defaultValue": "@{trigger().endTime}"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-project-spotify-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabaseLinkedService_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaseLinkedService_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaseLinkedService_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaseLinkedService_properties_typeProperties_database')]"
					},
					"AzureDataLakeStorageLinkedService_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorageLinkedService_properties_typeProperties_url')]"
					},
					"Tumbling Window Trigger for Backfilling_properties_pipeline_parameters_start_date": {
						"value": "[parameters('Tumbling Window Trigger for Backfilling_properties_pipeline_parameters_start_date')]"
					},
					"Tumbling Window Trigger for Backfilling_properties_pipeline_parameters_end_date": {
						"value": "[parameters('Tumbling Window Trigger for Backfilling_properties_pipeline_parameters_end_date')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}