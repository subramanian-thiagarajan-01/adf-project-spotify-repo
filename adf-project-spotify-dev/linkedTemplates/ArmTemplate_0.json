{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-project-spotify-dev"
		},
		"AzureSqlDatabaseLinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserver-project-spotify-dev.database.windows.net"
		},
		"AzureSqlDatabaseLinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-project-spotify-dev"
		},
		"AzureDataLakeStorageLinkedService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageprojectspotifydev.dfs.core.windows.net/"
		},
		"Tumbling Window Trigger for Backfilling_properties_pipeline_parameters_start_date": {
			"type": "string",
			"defaultValue": "@trigger().windowStartTime"
		},
		"Tumbling Window Trigger for Backfilling_properties_pipeline_parameters_end_date": {
			"type": "string",
			"defaultValue": "@trigger().windowEndTime"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureSqlDatabaseLinkedService')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('AzureSqlDatabaseLinkedService_properties_typeProperties_server')]",
					"database": "[parameters('AzureSqlDatabaseLinkedService_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SystemAssignedManagedIdentity"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/uam-storage-account')]",
			"type": "Microsoft.DataFactory/factories/credentials",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "ManagedIdentity",
				"typeProperties": {
					"resourceId": "/subscriptions/2891def1-4900-420a-b281-68e5d5ab47e4/resourcegroups/rg-project-spotify-dev/providers/Microsoft.ManagedIdentity/userAssignedIdentities/uam-project-spotify-dev"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureSqlTableDataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabaseLinkedService",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"tableName": {
						"type": "string"
					},
					"schemaName": {
						"type": "string",
						"defaultValue": "dbo"
					}
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": {
						"value": "@dataset().schemaName",
						"type": "Expression"
					},
					"table": {
						"value": "@dataset().tableName",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureSqlDatabaseLinkedService')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureDataLakeStorageLinkedService')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('AzureDataLakeStorageLinkedService_properties_typeProperties_url')]",
					"credential": {
						"referenceName": "uam-storage-account",
						"type": "CredentialReference"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/credentials/uam-storage-account')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureDataLakeDataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureDataLakeStorageLinkedService",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"container": {
						"type": "string"
					},
					"fileName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().fileName",
							"type": "Expression"
						},
						"fileSystem": {
							"value": "@dataset().container",
							"type": "Expression"
						}
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureDataLakeStorageLinkedService')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Backfilling Pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup Tables Metadata",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": false,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"dataset": {
								"referenceName": "AzureDataLakeDataset",
								"type": "DatasetReference",
								"parameters": {
									"container": "adf-pipeline-metadata",
									"fileName": "adf-pipeline-metadata.json"
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "For Each Table",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup Tables Metadata",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup Tables Metadata').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 3,
							"activities": [
								{
									"name": "If isFullLoad",
									"type": "IfCondition",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@item().isFullLoad",
											"type": "Expression"
										},
										"ifFalseActivities": [
											{
												"name": "Copy backfilling data",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": {
															"value": "SELECT * FROM\n\n@{item().schema}.@{item().table}\n\nWHERE\n\n@{item().timestampColumn} > '@{pipeline().parameters.start_date}'\nAND \n@{item().timestampColumn} <= '@{pipeline().parameters.end_date}'",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "JsonSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "JsonWriteSettings"
														}
													},
													"enableStaging": false
												},
												"inputs": [
													{
														"referenceName": "AzureSqlTableDataset",
														"type": "DatasetReference",
														"parameters": {
															"tableName": {
																"value": "@item().table",
																"type": "Expression"
															},
															"schemaName": {
																"value": "@item().schema",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "AzureDataLakeDataset",
														"type": "DatasetReference",
														"parameters": {
															"container": "bronze",
															"fileName": {
																"value": "@concat(\n    item().table, \n    '/',\n    item().table,\n    '_',\n    'backfilled',\n    utcNow())\n\n",
																"type": "Expression"
															}
														}
													}
												]
											}
										],
										"ifTrueActivities": [
											{
												"name": "Copy Full Load Data",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "JsonSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "JsonWriteSettings"
														}
													},
													"enableStaging": false
												},
												"inputs": [
													{
														"referenceName": "AzureSqlTableDataset",
														"type": "DatasetReference",
														"parameters": {
															"tableName": {
																"value": "@item().table",
																"type": "Expression"
															},
															"schemaName": {
																"value": "@item().schema",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "AzureDataLakeDataset",
														"type": "DatasetReference",
														"parameters": {
															"container": "bronze",
															"fileName": {
																"value": "@concat(item().table, '/',item().table)",
																"type": "Expression"
															}
														}
													}
												]
											}
										]
									}
								}
							]
						}
					},
					{
						"name": "Fail If No Look Up Value",
						"type": "Fail",
						"dependsOn": [
							{
								"activity": "Lookup Tables Metadata",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"message": {
								"value": "@concat('Cannot connect to the Look Up Table', activity('Lookup Tables Metadata').error.message)",
								"type": "Expression"
							},
							"errorCode": {
								"value": "LOOKUP_NOT_FOUND",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"start_date": {
						"type": "string"
					},
					"end_date": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureDataLakeDataset')]",
				"[concat(variables('factoryId'), '/datasets/AzureSqlTableDataset')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Incremental Ingestion Pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "If Incremental Count greater than 0",
						"type": "IfCondition",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(pipeline().parameters.incrementalCountValue,0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Copy Incremental Data",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "Set Current Timestamp",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "SELECT * FROM\n\n@{pipeline().parameters.inputItem.schema}.@{pipeline().parameters.inputItem.table}\n\nWHERE\n\n@{pipeline().parameters.inputItem.timestampColumn} > '@{pipeline().parameters.watermarkTimestamp}'",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "AzureSqlTableDataset",
											"type": "DatasetReference",
											"parameters": {
												"tableName": {
													"value": "@pipeline().parameters.inputItem.table",
													"type": "Expression"
												},
												"schemaName": {
													"value": "@pipeline().parameters.inputItem.schema",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "AzureDataLakeDataset",
											"type": "DatasetReference",
											"parameters": {
												"container": "bronze",
												"fileName": {
													"value": "@concat(\n    pipeline().parameters.inputItem.table, \n    '/',\n    pipeline().parameters.inputItem.table,\n    '_',\n    variables('current_timestamp'))\n\n",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Get Max Timestamp from Source DB",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "Copy Incremental Data",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "SELECT MAX(@{pipeline().parameters.inputItem.timestampColumn}) AS MaxTimestamp\n\nFROM\n\n@{pipeline().parameters.inputItem.schema}.@{pipeline().parameters.inputItem.table}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "AzureSqlTableDataset",
											"type": "DatasetReference",
											"parameters": {
												"tableName": {
													"value": "@pipeline().parameters.inputItem.table",
													"type": "Expression"
												},
												"schemaName": {
													"value": "@pipeline().parameters.inputItem.schema",
													"type": "Expression"
												}
											}
										}
									}
								},
								{
									"name": "Fill Watermark",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "Get Max Timestamp from Source DB",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "JsonSource",
											"additionalColumns": [
												{
													"name": "watermarkTimestamp",
													"value": {
														"value": "@activity('Get Max Timestamp from Source DB').output.firstRow.MaxTimestamp",
														"type": "Expression"
													}
												}
											],
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "JsonReadSettings"
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "AzureDataLakeDataset",
											"type": "DatasetReference",
											"parameters": {
												"container": "adf-pipeline-metadata",
												"fileName": "empty.json"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "AzureDataLakeDataset",
											"type": "DatasetReference",
											"parameters": {
												"container": "adf-pipeline-metadata",
												"fileName": {
													"value": "@concat(   \n    'watermarks/', \n    pipeline().parameters.inputItem.schema, \n    '.', \n    pipeline().parameters.inputItem.table, \n    '.json') ",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Set Current Timestamp",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "current_timestamp",
										"value": {
											"value": "@utcNow()",
											"type": "Expression"
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"inputItem": {
						"type": "object"
					},
					"incrementalCountValue": {
						"type": "int"
					},
					"watermarkTimestamp": {
						"type": "string"
					}
				},
				"variables": {
					"current_timestamp": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTableDataset')]",
				"[concat(variables('factoryId'), '/datasets/AzureDataLakeDataset')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Ingestion Pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup Tables Metadata",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": false,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"dataset": {
								"referenceName": "AzureDataLakeDataset",
								"type": "DatasetReference",
								"parameters": {
									"container": "adf-pipeline-metadata",
									"fileName": "adf-pipeline-metadata.json"
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "For Each Table",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup Tables Metadata",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup Tables Metadata').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 3,
							"activities": [
								{
									"name": "If isFullLoad",
									"type": "IfCondition",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@item().isFullLoad",
											"type": "Expression"
										},
										"ifFalseActivities": [
											{
												"name": "Incremental Ingestion Pipeline Execution",
												"type": "ExecutePipeline",
												"dependsOn": [
													{
														"activity": "Get Count of Incremental Records",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "Incremental Ingestion Pipeline",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true,
													"parameters": {
														"inputItem": {
															"value": "@item()",
															"type": "Expression"
														},
														"incrementalCountValue": {
															"value": "@activity('Get Count of Incremental Records').output.resultSets[0].rows[0].countValue",
															"type": "Expression"
														},
														"watermarkTimestamp": {
															"value": "@activity('Lookup Watermark').output.firstRow.watermarkTimestamp",
															"type": "Expression"
														}
													}
												}
											},
											{
												"name": "Get Count of Incremental Records",
												"type": "Script",
												"dependsOn": [
													{
														"activity": "Lookup Watermark",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
