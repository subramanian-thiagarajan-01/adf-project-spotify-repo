{
	"name": "Ingestion Pipeline",
	"properties": {
		"activities": [
			{
				"name": "Lookup Tables Metadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "AzureDataLakeDataset",
						"type": "DatasetReference",
						"parameters": {
							"container": "adf-pipeline-metadata",
							"fileName": "adf-pipeline-metadata.json"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set Current Timestamp",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "current_timestamp",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "For Each Table",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup Tables Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Current Timestamp",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup Tables Metadata').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 3,
					"activities": [
						{
							"name": "If isFullLoad",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@item().isFullLoad",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Incremental Ingestion Pipeline Execution",
										"type": "ExecutePipeline",
										"dependsOn": [
											{
												"activity": "Get Count of Incremental Records",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "Incremental Ingestion Pipeline",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"inputItem": {
													"value": "@item()",
													"type": "Expression"
												},
												"incrementalCountValue": {
													"value": "@activity('Get Count of Incremental Records').output.countValue",
													"type": "Expression"
												},
												"watermarkTimestamp": {
													"value": "@activity('Lookup Watermark').output.firstRow.watermarkTimestamp",
													"type": "Expression"
												}
											}
										}
									},
									{
										"name": "Get Count of Incremental Records",
										"type": "Script",
										"dependsOn": [
											{
												"activity": "Lookup Watermark",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "AzureSqlDatabaseLinkedService",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "SELECT COUNT(*) AS countValue\nFROM @{item().schema}.@{item().table}\nWHERE @{item().timestampColumn} >= '@{activity('Lookup Watermark').output.firstRow.watermarkTimestamp}'\n",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									},
									{
										"name": "Lookup Watermark",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "JsonSource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "JsonReadSettings"
												}
											},
											"dataset": {
												"referenceName": "AzureDataLakeDataset",
												"type": "DatasetReference",
												"parameters": {
													"container": "adf-pipeline-metadata",
													"fileName": {
														"value": "@concat(   \n    'watermarks/', \n    item().schema, \n    '.', \n    item().table, \n    '.json') \n\n",
														"type": "Expression"
													}
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy Full Load Data",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "JsonSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "JsonWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "AzureSqlTableDataset",
												"type": "DatasetReference",
												"parameters": {
													"tableName": {
														"value": "@item().table",
														"type": "Expression"
													},
													"schemaName": {
														"value": "@item().schema",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "AzureDataLakeDataset",
												"type": "DatasetReference",
												"parameters": {
													"container": "bronze",
													"fileName": {
														"value": "@concat(item().table, '/',item().table)",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"variables": {
			"current_timestamp": {
				"type": "String"
			}
		},
		"annotations": []
	}
}