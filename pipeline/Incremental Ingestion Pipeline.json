{
	"name": "Incremental Ingestion Pipeline",
	"properties": {
		"activities": [
			{
				"name": "Copy Incremental Data",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM\n\n@{pipeline().parameters.inputItem.schema}.@{pipeline().parameters.inputItem.table}\n\nWHERE\n\n@{pipeline().parameters.inputItem.timestampColumn} >= @{activity('Lookup Watermark').output.firstRow.watermarkTimestamp}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "AzureSqlTableDataset",
						"type": "DatasetReference",
						"parameters": {
							"tableName": {
								"value": "@pipeline().parameters.inputItem.table",
								"type": "Expression"
							},
							"schemaName": {
								"value": "@pipeline().parameters.inputItem.schema",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "AzureDataLakeDataset",
						"type": "DatasetReference",
						"parameters": {
							"container": "bronze",
							"fileName": {
								"value": "@concat(item().table, '/',item().table,'_',variables('current_timestamp'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Lookup Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "AzureDataLakeDataset",
						"type": "DatasetReference",
						"parameters": {
							"container": "adf-pipeline-metadata",
							"fileName": {
								"value": "@concat(   \n    'watermarks/', \n    pipeline().parameters.inputItem.schema, \n    '.', \n    pipeline().parameters.inputItem.table, \n    '.json') \n\n",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Get Max Timestamp from Source DB",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Copy Incremental Data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT MAX(@{pipeline().parameters.inputItem.timestampColumn}) AS MaxTimestamp\n\nFROM\n\n@{pipeline().parameters.inputItem.schema}.@{pipeline().parameters.inputItem.table}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTableDataset",
						"type": "DatasetReference",
						"parameters": {
							"tableName": {
								"value": "@pipeline().parameters.inputItem.table",
								"type": "Expression"
							},
							"schemaName": {
								"value": "@pipeline().parameters.inputItem.schema",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Fill Watermark",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Get Max Timestamp from Source DB",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "watermarkTimestamp",
								"value": {
									"value": "@activity('Get Max Timestamp from Source DB').output.firstRow.MaxTimestamp",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "AzureDataLakeDataset",
						"type": "DatasetReference",
						"parameters": {
							"container": "adf-pipeline-metadata",
							"fileName": "empty.json"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "AzureDataLakeDataset",
						"type": "DatasetReference",
						"parameters": {
							"container": "adf-pipeline-metadata",
							"fileName": {
								"value": "@concat(   \n    'watermarks/', \n    pipeline().parameters.inputItem.schema, \n    '.', \n    pipeline().parameters.inputItem.table, \n    '.json') ",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"inputItem": {
				"type": "object"
			}
		},
		"annotations": []
	}
}